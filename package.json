{
  "name": "plotify-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd apps/api && ./.venv/bin/python main.py",
    "dev:worker": "cd apps/api && ./.venv/bin/python -c \"from arq.cli import cli; raise SystemExit(cli())\" workers.main_worker.WorkerSettings",
    "build:web": "pnpm --filter web build",
    "test:web": "pnpm --filter web test",
    "typecheck:web": "pnpm --filter web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:api": "cd apps/api && .venv/bin/python -m pytest -q",
    "contracts:generate": "cd apps/api && ./.venv/bin/python scripts/export_openapi_contract.py",
    "verify:migrations": "pnpm --filter @plotify/database verify:migrations",
    "check:agent-context": "node scripts/agent-context/check.mjs",
    "security:scan": "node scripts/production-readiness/security-scan.mjs",
    "verify:production-readiness": "node scripts/production-readiness/verify.mjs",
    "evidence:archive": "node scripts/production-readiness/evidence-archive.mjs",
    "auth:hardening-guarded": "node scripts/production-readiness/auth-hardening-guarded.mjs",
    "release:preflight": "node scripts/production-readiness/release-preflight.mjs",
    "restore:rehearsal": "node scripts/production-readiness/restore-rehearsal.mjs",
    "verify:generated-clean": "node scripts/production-readiness/verify-generated-clean.mjs",
    "feature-controls": "node scripts/production-readiness/feature-controls.mjs",
    "capabilities:cutover": "node scripts/production-readiness/capabilities-cutover.mjs",
    "migrations:push-guarded": "node scripts/production-readiness/migrations-push-guarded.mjs",
    "update:webhook": "cd apps/api && ./.venv/bin/python scripts/dev-only/update_ngrok_webhook.py"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "prettier": "^3.8.3"
  }
}
