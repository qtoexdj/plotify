{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotify.local/schemas/deployment-trust-policy.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "allowedIssuers",
    "requiredClaims",
    "maximumManifestAgeSeconds",
    "signatureAlgorithms"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "allowedIssuers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer", "identityPattern", "publicKeyFingerprint"],
        "properties": {
          "issuer": { "type": "string", "minLength": 1 },
          "identityPattern": { "type": "string", "minLength": 1 },
          "publicKeyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "requiredClaims": {
      "const": [
        "sourceSha",
        "deploymentId",
        "environmentFingerprint",
        "expectedRoster",
        "roleArtifactDigests"
      ]
    },
    "maximumManifestAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "signatureAlgorithms": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["EdDSA", "ES256", "RS256"] },
      "uniqueItems": true
    }
  }
}
