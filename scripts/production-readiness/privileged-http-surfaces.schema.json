{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotify.local/schemas/privileged-http-surfaces.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceManifestHash", "surfaces"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceManifestHash": { "$ref": "#/$defs/digest" },
    "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "method",
        "routeOrSymbol",
        "callsiteHash",
        "callers",
        "trustedPrincipal",
        "resourceTenant",
        "businessRole",
        "serviceCapability",
        "audit",
        "idempotency",
        "negativeTestIds"
      ],
      "properties": {
        "runtime": { "enum": ["web", "api", "worker"] },
        "method": { "type": "string", "minLength": 1 },
        "routeOrSymbol": { "type": "string", "minLength": 1 },
        "callsiteHash": { "$ref": "#/$defs/digest" },
        "callers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "trustedPrincipal": { "type": "string", "minLength": 1 },
        "resourceTenant": { "type": "string", "minLength": 1 },
        "businessRole": { "type": "string", "minLength": 1 },
        "serviceCapability": { "type": "string", "minLength": 1 },
        "audit": { "type": "string", "minLength": 1 },
        "idempotency": { "type": "string", "minLength": 1 },
        "negativeTestIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
