{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotify.local/schemas/report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "startedAt",
    "finishedAt",
    "git",
    "target",
    "deployment",
    "versions",
    "featureControls",
    "stages",
    "verdict",
    "rolloutStatus",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "format": "uuid" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "git": { "$ref": "#/$defs/git" },
    "target": { "$ref": "#/$defs/target" },
    "deployment": { "$ref": "#/$defs/deployment" },
    "versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "featureControls": { "$ref": "https://plotify.local/schemas/feature-controls.v1.json" },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } },
    "verdict": { "enum": ["GO", "NO-GO"] },
    "rolloutStatus": { "enum": ["not_started", "in_progress", "rolled_back", "complete"] },
    "blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "branch", "dirty"],
      "properties": {
        "sha": { "$ref": "#/$defs/sha" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "projectRefFingerprint"],
      "properties": {
        "kind": { "enum": ["local", "linked", "branch"] },
        "projectRefFingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha",
        "manifestDigest",
        "provenanceVerified",
        "webArtifactDigest",
        "apiArtifactDigest",
        "workerArtifactDigest"
      ],
      "properties": {
        "sourceSha": { "$ref": "#/$defs/sha" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "provenanceVerified": { "type": "boolean" },
        "webArtifactDigest": { "$ref": "#/$defs/digest" },
        "apiArtifactDigest": { "$ref": "#/$defs/digest" },
        "workerArtifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidenceDigest"],
      "properties": {
        "name": {
          "enum": [
            "preflight",
            "migration_parity",
            "legacy_inventory",
            "security",
            "database_tests",
            "api_contracts",
            "web_quality",
            "concurrency_recovery",
            "browser_a11y",
            "restore_rehearsal",
            "live_smoke",
            "verdict"
          ]
        },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
