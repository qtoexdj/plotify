          "estadoCivil": { "value": "casado", "state": "approved", "evidenceRef": "evidence:2" }
        }
      ]
    },
    {
      "id": "filler-line",
      "expectedSemanticStatus": "failed",
      "expectedIssueCode": "SEM_FILLER_LINE",
