          "nombre": { "value": "Vendedora", "state": "approved", "evidenceRef": "evidence:1" },
          "rut": { "value": "11.111.111-1", "state": "approved", "evidenceRef": "evidence:1" },
          "nacionalidad": { "value": "chilena", "state": "approved", "evidenceRef": "evidence:1" },
          "estadoCivil": { "value": "soltera", "state": "approved", "evidenceRef": "evidence:1" }
        }
      ]
    },
    {
      "id": "literal-placeholder",
      "expectedSemanticStatus": "failed",
      "expectedIssueCode": "SEM_PLACEHOLDER_LITERAL",
      "resolvedText": "Doña Vendedora, de nacionalidad [NACIONALIDAD], comparece."
    },
    {
      "id": "unresolved-token",
